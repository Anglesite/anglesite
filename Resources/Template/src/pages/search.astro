---
import BaseLayout from "../layouts/BaseLayout.astro";

// Reader-facing archive search (#974), the published-site counterpart to the app's own toolbar
// search. Backed by Pagefind, which indexes `dist/` in the `postbuild` step and serves a static
// index from `/pagefind/` — no server, no third-party service, nothing to keep running.
//
// Uses Pagefind's Component UI (the supported path for new integrations as of Pagefind 1.5;
// the older Default UI still works but is no longer recommended). It's declarative custom
// elements with no initialization code, which also means no inline script for this site's CSP
// to reject, and it ships its own live-region announcer for screen readers.
//
// The index only exists after a real build, so this page shows its unavailable message under
// `astro dev`. Preview it with `npm run build && npm run preview`.
---

<BaseLayout title="Search" description="Search this site.">
  <link slot="head" rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />

  <!-- Keeps the search page itself out of its own results, where it would be pure noise. -->
  <main data-pagefind-ignore>
    <h1>Search</h1>

    <pagefind-searchbox></pagefind-searchbox>

    <p class="search-unavailable">
      Search isn't available here — the index is generated by a full site build. You can still
      <a href="/blog/">browse the archive</a> or <a href="/rss.xml">subscribe by feed</a>.
    </p>

    <noscript>
      <p>
        Search needs JavaScript, because the index is read in your browser rather than on a
        server. You can still <a href="/blog/">browse the archive</a> or
        <a href="/rss.xml">subscribe by feed</a>.
      </p>
    </noscript>
  </main>
</BaseLayout>

<!--
  A plain external module, not an Astro-processed script: `/pagefind/pagefind-component-ui.js`
  is generated by this build's own `postbuild` step, so it doesn't exist at the time Astro would
  try to resolve an import of it. Same-origin, so `script-src 'self'` covers it.
-->
<script is:inline type="module" src="/pagefind/pagefind-component-ui.js"></script>

<style>
  /* `:defined` is the standard way to ask "did the custom element upgrade?" — so the fallback
     shows exactly when the Pagefind bundle is missing (a dev server, or a build whose index
     step didn't run) and hides itself the moment the real search box is live. Pure CSS, so it
     works before and without any script running. */
  pagefind-searchbox:not(:defined) {
    display: none;
  }

  pagefind-searchbox:defined ~ .search-unavailable {
    display: none;
  }
</style>
