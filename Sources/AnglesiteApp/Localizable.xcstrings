    "%@/%@ accepts private vulnerability reports. Routing reports there keeps them out of public issues and off your inbox." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@/%2$@ accepts private vulnerability reports. Routing reports there keeps them out of public issues and off your inbox."
          }
        }
      }
    },
    "%@/%@ has private vulnerability reporting turned off, so its advisory form can't accept reports yet. Anglesite can turn it on for you." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@/%2$@ has private vulnerability reporting turned off, so its advisory form can't accept reports yet. Anglesite can turn it on for you."
